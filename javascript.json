{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Preserve JavaScript dependency ranges, delay ordinary npm releases for seven days, and group related non-major npm updates.",
  "extends": ["security:minimumReleaseAgeNpm"],
  "packageRules": [
    {
      "description": "Preserve existing pinned and ranged dependency declarations.",
      "matchManagers": ["npm"],
      "rangeStrategy": "replace"
    },
    {
      "description": "Wait seven days for ordinary npm major, minor, and patch releases.",
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group non-major lint and format tooling without including Next.js or Storybook integrations.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "eslint",
        "@eslint/*",
        "@eslint-react/eslint-plugin",
        "@stylistic/eslint-plugin",
        "@typescript-eslint/*",
        "typescript-eslint",
        "eslint-*",
        "!eslint-config-next",
        "!eslint-plugin-storybook",
        "prettier",
        "lint-staged"
      ],
      "groupName": "Lint and format tooling",
      "groupSlug": "lint-format-tooling"
    },
    {
      "description": "Group non-major Jest, ts-jest, and Testing Library updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "jest",
        "jest-*",
        "@jest/*",
        "@types/jest",
        "babel-jest",
        "ts-jest",
        "@testing-library/*"
      ],
      "groupName": "Test tooling",
      "groupSlug": "test-tooling"
    },
    {
      "description": "Group non-major Gno and TM2 JavaScript client updates, including the compatible TM2 RPC 2.x line.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@gnolang/gno-js-client", "@gnolang/tm2-js-client", "@gnolang/tm2-rpc"],
      "matchJsonata": ["packageName != '@gnolang/tm2-rpc' or newMajor = 2"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Gno JavaScript clients",
      "groupSlug": "gno-js-clients"
    },
    {
      "description": "Group non-major React Hook Form and validation resolver updates.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["react-hook-form", "@hookform/resolvers"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "React Hook Form",
      "groupSlug": "react-hook-form"
    }
  ]
}
