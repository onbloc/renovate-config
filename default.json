{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared dependency update policy for Onbloc repositories.",
  "extends": [
    "config:recommended",
    ":approveMajorUpdates"
  ],
  "ignorePresets": [":ignoreModulesAndTests"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/.yarn/cache/**",
    "**/.yarn/sdks/**"
  ],
  "automerge": false,
  "rebaseWhen": "conflicted",
  "pin": {
    "rebaseWhen": "conflicted"
  },
  "dependencyDashboard": true,
  "timezone": "Asia/Seoul",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "addLabels": ["renovate"],
  "ignoreScripts": true,
  "lockFileMaintenance": {
    "enabled": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["renovate-security"],
    "automerge": false,
    "prCreation": "immediate",
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null,
    "schedule": [],
    "groupName": null,
    "prConcurrentLimit": 0
  },
  "packageRules": [
    {
      "description": "Group Action references separately from runtime versions and images, keeping major updates separate.",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "dependencyDashboardApproval": false,
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "separateMajorMinor": true
    }
  ]
}
